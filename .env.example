# Public site URL used for canonical URLs, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional analytics IDs.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Optional Telegram notifications for lead forms.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Admin panel credentials. Set strong real values only on the server.
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
